CREATE OR REPLACE DYNAMIC TABLE KPI_CONTROL_TOWER_DT
    TARGET_LAG = '1 minute'
    WAREHOUSE = COMPUTE_WH
AS
SELECT
    COUNT(CASE WHEN STATUS NOT IN ('DOSTARCZONE') 
               AND UNLOADING_DATE >= CURRENT_DATE() THEN 1 END) as ACTIVE_ORDERS,
    COUNT(CASE WHEN STATUS = 'W_TRANSPORCIE' 
               AND UNLOADING_DATE >= CURRENT_DATE() THEN 1 END) as IN_TRANSIT,
    COUNT(CASE WHEN STATUS IN ('OPOZNIENIE_ZAŁADUNEK','OPOZNIENIE_ROZŁADUNEK')
               AND UNLOADING_DATE >= CURRENT_DATE() THEN 1 END) as ACTIVE_DELAYS,
    COUNT(CASE WHEN STATUS = 'DOSTARCZONE' 
               AND DATE(STATUS_TIMESTAMP) = CURRENT_DATE() THEN 1 END) as DELIVERED_TODAY
FROM (
    SELECT os.STATUS, os.STATUS_TIMESTAMP, o.UNLOADING_DATE
    FROM ORDER_STATUSES os
    JOIN ORDERS o ON os.ORDER_ID = o.ORDER_ID
    JOIN (
        SELECT ORDER_ID, MAX(STATUS_TIMESTAMP) as MAX_TS 
        FROM ORDER_STATUSES 
        GROUP BY ORDER_ID
    ) latest ON os.ORDER_ID = latest.ORDER_ID 
            AND os.STATUS_TIMESTAMP = latest.MAX_TS
);

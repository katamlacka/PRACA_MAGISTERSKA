CREATE OR REPLACE VIEW ACTIVE_ORDERS AS
SELECT
    o.ORDER_ID,
    o.CLIENT_ID,
    o.CLIENT_NAME,
    o.CARRIER_NAME,
    o.LOADING_DATE,
    o.ACTUAL_LOADING_DATE,
    o.UNLOADING_DATE,
    o.ACTUAL_UNLOADING_DATE,
    o.LOADING_PLACE_CITY,
    o.UNLOADING_PLACE_CITY,
    o.LOADING_PLACE_COUNTRY,
    o.UNLOADING_PLACE_COUNTRY,
    os.STATUS,
    os.STATUS_TIMESTAMP,
    os.REASON_CODE,
    os.REASON_DESC
FROM ORDERS o
JOIN (
    SELECT
        ORDER_ID, STATUS, STATUS_TIMESTAMP, REASON_CODE, REASON_DESC,
        ROW_NUMBER() OVER (PARTITION BY ORDER_ID ORDER BY STATUS_TIMESTAMP DESC) as rn
    FROM ORDER_STATUSES
) os ON o.ORDER_ID = os.ORDER_ID AND os.rn = 1
WHERE os.STATUS NOT IN ('DOSTARCZONE');


CREATE OR REPLACE VIEW LOCATION_ALERT_STATUS AS
SELECT
    l.LOCATION_ID,
    l.LOCATION_NAME,
    l.LOCATION_TYPE,
    l.LATITUDE,
    l.LONGITUDE,
    COALESCE(
        l.CLIENT_ID,
        (SELECT MAX(o.CLIENT_ID) FROM ORDERS o WHERE o.UNLOADING_LOCATION_ID = l.LOCATION_ID),
        (SELECT MAX(o.CLIENT_ID) FROM ORDERS o WHERE o.LOADING_LOCATION_ID = l.LOCATION_ID)
    ) AS CLIENT_ID,
    CASE
        WHEN EXISTS (
            SELECT 1 FROM ORDER_STATUSES os
            JOIN ORDERS o ON os.ORDER_ID = o.ORDER_ID
            JOIN (SELECT ORDER_ID, MAX(STATUS_TIMESTAMP) as MAX_TS FROM ORDER_STATUSES GROUP BY ORDER_ID) latest
            ON os.ORDER_ID = latest.ORDER_ID AND os.STATUS_TIMESTAMP = latest.MAX_TS
            WHERE os.STATUS = 'OPOZNIENIE_ZAŁADUNEK' AND o.LOADING_LOCATION_ID = l.LOCATION_ID
        ) THEN 'Opóźnienie załadunku'
        WHEN EXISTS (
            SELECT 1 FROM ORDER_STATUSES os
            JOIN ORDERS o ON os.ORDER_ID = o.ORDER_ID
            JOIN (SELECT ORDER_ID, MAX(STATUS_TIMESTAMP) as MAX_TS FROM ORDER_STATUSES GROUP BY ORDER_ID) latest
            ON os.ORDER_ID = latest.ORDER_ID AND os.STATUS_TIMESTAMP = latest.MAX_TS
            WHERE os.STATUS = 'OPOZNIENIE_ROZŁADUNEK' AND o.UNLOADING_LOCATION_ID = l.LOCATION_ID
        ) THEN 'Opóźnienie rozładunku'
        WHEN l.LOCATION_TYPE = 'WAREHOUSE' THEN 'Magazyn klienta'
        ELSE 'Brak opóźnień'
    END AS MAP_COLOR
FROM LOCATIONS l;



CREATE OR REPLACE VIEW DELAY_ALERTS AS
SELECT
    o.ORDER_ID, o.CLIENT_NAME, o.CARRIER_NAME, 
    o.LOADING_PLACE_CITY, o.UNLOADING_PLACE_CITY,
    o.LOADING_DATE, o.UNLOADING_DATE, 
    os.STATUS, os.STATUS_TIMESTAMP, 
    os.REASON_CODE, os.REASON_DESC
FROM ORDERS o
JOIN (
    SELECT
        ORDER_ID, STATUS, STATUS_TIMESTAMP, REASON_CODE, REASON_DESC,
        ROW_NUMBER() OVER (PARTITION BY ORDER_ID ORDER BY STATUS_TIMESTAMP DESC) as rn
    FROM ORDER_STATUSES
) os ON o.ORDER_ID = os.ORDER_ID AND os.rn = 1
WHERE os.STATUS IN ('OPOZNIENIE_ZAŁADUNEK', 'OPOZNIENIE_ROZŁADUNEK')
AND o.UNLOADING_DATE >= CURRENT_DATE();


CREATE OR REPLACE VIEW AT_RISK_ORDERS AS
SELECT
    o.ORDER_ID,
    o.CLIENT_NAME,
    o.CARRIER_NAME,
    o.LOADING_PLACE_COUNTRY,
    o.UNLOADING_PLACE_COUNTRY,
    o.LOADING_PLACE_CITY,
    o.UNLOADING_PLACE_CITY,
    CONCAT(o.LOADING_PLACE_CITY, ' (', o.LOADING_PLACE_COUNTRY, ') -> ', o.UNLOADING_PLACE_CITY, ' (', o.UNLOADING_PLACE_COUNTRY, ')') AS ROUTE_RELATION,
    os.STATUS,
    os.REASON_DESC,
    CASE
        WHEN os.STATUS IN ('NOWE', 'POTWIERDZONE', 'ZAŁADUNEK', 'OPOZNIENIE_ZAŁADUNEK') THEN 'LOADING'
        ELSE 'DELIVERY'
    END AS RISK_TYPE,
    DATEDIFF('minute', CURRENT_TIMESTAMP(), CASE
        WHEN os.STATUS IN ('NOWE', 'POTWIERDZONE', 'ZAŁADUNEK', 'OPOZNIENIE_ZAŁADUNEK') THEN o.LOADING_DATE
        ELSE o.UNLOADING_DATE
    END) AS MINUTES_TO_EVENT,
    TO_CHAR(o.UNLOADING_DATE, 'HH24:MI') AS PLANNED_DELIVERY_TIME,
    CASE
        WHEN os.STATUS IN ('OPOZNIENIE_ZAŁADUNEK', 'OPOZNIENIE_ROZŁADUNEK') THEN '1. CRITICAL'
        WHEN os.STATUS IN ('NOWE', 'POTWIERDZONE', 'ZAŁADUNEK', 'W_TRANSPORCIE') THEN '2. HIGH'
        ELSE '3. MEDIUM'
    END AS RISK_LEVEL
FROM ORDERS o
JOIN (
    SELECT
        ORDER_ID, STATUS, REASON_DESC, STATUS_TIMESTAMP,
        ROW_NUMBER() OVER (PARTITION BY ORDER_ID ORDER BY STATUS_TIMESTAMP DESC) as rn
    FROM ORDER_STATUSES
) os ON o.ORDER_ID = os.ORDER_ID AND os.rn = 1;

CREATE OR REPLACE VIEW LOADING_RISK_ORDERS AS
SELECT * FROM AT_RISK_ORDERS
WHERE RISK_TYPE = 'LOADING';

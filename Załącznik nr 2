USE DATABASE TRIAL_DB;
USE SCHEMA PUBLIC;


CREATE TABLE IF NOT EXISTS CLIENTS (
    CLIENT_ID VARCHAR,
    CLIENT_NAME VARCHAR,
    COUNTRY VARCHAR
);

CREATE TABLE IF NOT EXISTS CARRIERS (
    CARRIER_ID VARCHAR,
    CARRIER_NAME VARCHAR,
    COUNTRY VARCHAR,
    CLIENT_ID VARCHAR
);

CREATE TABLE IF NOT EXISTS VEHICLES (
    VEHICLE_ID VARCHAR,
    PLATE_NUMBER VARCHAR,
    TRUCK_TYPE VARCHAR,
    CAPACITY_VOLUME FLOAT,
    CAPACITY_WEIGHT FLOAT,
    CAPACITY_PALLET INT,
    COUNTRY VARCHAR,
    CARRIER_ID VARCHAR
);

CREATE TABLE IF NOT EXISTS LOCATIONS (
    LOCATION_ID VARCHAR,
    LOCATION_NAME VARCHAR,
    STREET VARCHAR,
    POSTAL_CODE VARCHAR,
    CITY VARCHAR,
    COUNTRY VARCHAR,
    LATITUDE FLOAT,
    LONGITUDE FLOAT,
    LOCATION_TYPE VARCHAR,
    CLIENT_ID VARCHAR
);

CREATE TABLE IF NOT EXISTS ORDERS (
    ORDER_ID VARCHAR,
    CLIENT_ID VARCHAR,
    CLIENT_NAME VARCHAR,
    CARRIER_ID VARCHAR,
    CARRIER_NAME VARCHAR,
    VEHICLE_ID VARCHAR,
    LOADING_DATE TIMESTAMP,
    ACTUAL_LOADING_DATE TIMESTAMP,
    UNLOADING_DATE TIMESTAMP,
    ACTUAL_UNLOADING_DATE TIMESTAMP,
    LOADING_LOCATION_ID VARCHAR,
    LOADING_PLACE_NAME VARCHAR,
    LOADING_PLACE_STREET VARCHAR,
    LOADING_PLACE_POSTALCODE VARCHAR,
    LOADING_PLACE_CITY VARCHAR,
    LOADING_PLACE_COUNTRY VARCHAR,
    UNLOADING_LOCATION_ID VARCHAR,
    UNLOADING_PLACE_NAME VARCHAR,
    UNLOADING_PLACE_STREET VARCHAR,
    UNLOADING_PLACE_POSTALCODE VARCHAR,
    UNLOADING_PLACE_CITY VARCHAR,
    UNLOADING_PLACE_COUNTRY VARCHAR,
    WEIGHT FLOAT,
    VOLUME FLOAT,
    PALLET INT,
    TRUCK_TYPE VARCHAR,
    TRUCK_CAPACITY_WEIGHT FLOAT,
    TRUCK_CAPACITY_VOLUME FLOAT
);

CREATE TABLE IF NOT EXISTS ORDER_STATUSES (
    ORDER_ID VARCHAR,
    STATUS VARCHAR,
    STATUS_TIMESTAMP TIMESTAMP,
    REASON_CODE VARCHAR,
    REASON_DESC VARCHAR
);
